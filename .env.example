# ---------------------------------------------------------------------------
# Spraay Batch Payouts — environment variables
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Shopify app credentials ------------------------------------------------
# Create an app at https://dev.shopify.com → Apps → Create app → Custom distribution.
# SHOPIFY_API_KEY is the app's Client ID. It is public (it ships in the browser
# bundle), so it is safe to commit or share.
SHOPIFY_API_KEY=your_shopify_app_client_id

# SHOPIFY_API_SECRET is the app's Client Secret. Treat it like a password —
# it signs webhook HMACs and OAuth exchanges. Never commit it.
SHOPIFY_API_SECRET=your_shopify_app_secret

# --- App URL ----------------------------------------------------------------
# The public HTTPS origin where this app is hosted. Must match the "App URL"
# in your Shopify app settings, and must be the prefix of every redirect URL.
# No trailing slash.
SHOPIFY_APP_URL=https://your-app.up.railway.app

# --- Access scopes ----------------------------------------------------------
# Intentionally empty. Spraay sends USDC payouts on Base and never reads or
# writes Shopify store resources, so it requests no scopes. Leave this blank
# unless you fork the app to use Shopify data — and keep it in sync with
# `scopes` in shopify.app.toml.
SCOPES=

# --- Database (PostgreSQL) --------------------------------------------------
# Supabase free tier is plenty. Both URLs point at the same database:
#   DATABASE_URL — pooled connection (transaction pooler, port 6543) used at runtime
#   DIRECT_URL   — direct/session connection (port 5432) used by `prisma migrate`
# Keep `?schema=shopify` on both so the app's tables stay in their own schema.
DATABASE_URL=postgresql://user:password@host:6543/postgres?schema=shopify&pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres?schema=shopify

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production

# The port the server binds to. This MUST match the target port of your host's
# public domain. On Railway the Dockerfile's `EXPOSE 3000` sets the domain's
# target port to 3000, so pin PORT=3000 — otherwise Railway injects PORT=8080,
# the proxy still routes to :3000, and every route returns a 502.
PORT=3000

# --- Optional ---------------------------------------------------------------
# Only needed if your development store uses a custom domain.
# SHOP_CUSTOM_DOMAIN=shop.example.com
